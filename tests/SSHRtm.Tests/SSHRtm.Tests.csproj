<Project Sdk="Microsoft.NET.Sdk">
  <!-- SSHRtm itself targets net10.0-windows (DPAPI). Its logging, metrics and UI code is plain .NET, so the
       tests compile those files in directly and run anywhere, CI's Linux runners included. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The tests pass no cancellation tokens: each is quick, and none waits on anything outside. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\Config.cs" Link="App\Config.cs" />
    <Compile Include="..\..\StateStore.cs" Link="App\StateStore.cs" />
    <Compile Include="..\..\Logging\*.cs" Link="App\Logging\%(Filename)%(Extension)" />
    <Compile Include="..\..\Metrics\*.cs" Link="App\Metrics\%(Filename)%(Extension)" />
    <Compile Include="..\..\UI\*.cs" Link="App\UI\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
